generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  commissionNotes String?
  commissionRate  Float?
  deletedAt       DateTime?
  supportUrl      String?
  stations        Station[]
  users           User[]
  vehicles        Vehicle[]
  wallet          Wallet?
  configs         SystemConfig[]
  parcels         Parcel[]
  pricingRules    PricingRule[]
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  roleId           String?
  phone            String?        @unique
  fcmToken         String?
  isFirstLogin     Boolean        @default(true)
  loginCode        String?
  organizationId   String?
  stationId        String?
  isActive         Boolean        @default(true)
  deletedAt        DateTime?
  sessions         AuthSession[]
  approvedParcels  Parcel[]       @relation("AdminApprovedParcel")
  parcelRequests    Parcel[]       @relation("UserParcelRequests")
  parcelsDispatched Parcel[]      @relation("Dispatcher")
  parcelsOffloaded Parcel[]       @relation("Offloader")
  parcelsDelivered  Parcel[]      @relation("Deliverer")
  parcelsCanceled   Parcel[]      @relation("Canceler")
  approvedPayments Payment[]      @relation("AdminApprovedPayments")
  organization     Organization?  @relation(fields: [organizationId], references: [id])
  role             Role?          @relation(fields: [roleId], references: [id])
  station          Station?       @relation("StationUsers", fields: [stationId], references: [id])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  deviceId         String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Parcel {
  id                  String      @id @default(cuid())
  userId              String?
  fromAddress         String
  toAddress           String
  serviceType         String
  peopleNeeded        Int         @default(0)
  parcelType          String
  parcelSize          String
  receiverName        String
  receiverPhone       String
  receiverPays        Boolean     @default(false)
  additionalServices  Json?
  pickupType          String
  status              ParcelStatus     @default(PENDING)
  reason              String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  approvedById        String?
  amount              Float?
  rejectionReason     String?
  wagonType           String?     @default("STANDARD")
  condition           String?
  height              Float?
  isFragile           Boolean     @default(false)
  length              Float?
  specialInstructions String?
  urgency             String      @default("Normal")
  weight              Float       @default(0)
  width               Float?
  deletedAt           DateTime?
  organizationId      String?
  deliveryOtp         String?
  trackingNumber      String      @unique @default(cuid())
  
  isCanceled          Boolean          @default(false)
  cancellationReason  String?
  travelDate          DateTime?
  
  vehicleId           String?
  dispatcherId        String?
  offloaderId         String?
  delivererId         String?
  cancelerId          String?
  originId            String?
  destinationId       String?

  approvedBy          User?            @relation("AdminApprovedParcel", fields: [approvedById], references: [id])
  user                User?            @relation("UserParcelRequests", fields: [userId], references: [id])
  dispatcher          User?            @relation("Dispatcher", fields: [dispatcherId], references: [id])
  offloader           User?            @relation("Offloader", fields: [offloaderId], references: [id])
  deliverer           User?            @relation("Deliverer", fields: [delivererId], references: [id])
  canceler            User?            @relation("Canceler", fields: [cancelerId], references: [id])
  vehicle             Vehicle?         @relation(fields: [vehicleId], references: [id])
  origin              Station?         @relation("OriginStation", fields: [originId], references: [id])
  destination         Station?         @relation("DestinationStation", fields: [destinationId], references: [id])
  organization        Organization?    @relation(fields: [organizationId], references: [id])

  payment             Payment?
  tracking            ParcelTracking[]
  otps                OTP[]
}

model Payment {
  id                   String           @id @default(cuid())
  parcelId              String           @unique
  userId               String
  approvedById         String?
  amount               Float
  status               String           @default("PENDING")
  transactionReference String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  paidAt               DateTime?
  paymentMethod        String?
  receiptUrl           String?
  deletedAt            DateTime?
  organizationId       String?
  providerId           String?
  commission           Float?
  netAmount            Float?
  systemFee            Float?
  approvedBy           User?            @relation("AdminApprovedPayments", fields: [approvedById], references: [id])
  parcel               Parcel           @relation(fields: [parcelId], references: [id])
  provider             PaymentProvider? @relation(fields: [providerId], references: [id])
}

model PaymentProvider {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  payments    Payment[]
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  basePrice   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingRule {
  id        String    @id @default(cuid())
  name      String    @unique
  type      String
  value     Float
  condition String?
  isActive  Boolean   @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Station {
  id             String        @id @default(cuid())
  name           String        @unique
  code           String        @unique
  location       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  deletedAt      DateTime?
  rating         Float         @default(5.0)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  users          User[]        @relation("StationUsers")
  parcelsOrigin  Parcel[]      @relation("OriginStation")
  parcelsDest    Parcel[]      @relation("DestinationStation")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  action         String
  resource       String
  details        Json?
  createdAt      DateTime @default(now())
  organizationId String?
}

model AppVersion {
  id                  String    @id @default(cuid())
  version             String
  minSupportedVersion String
  forceUpdate         Boolean   @default(false)
  downloadUrl         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
}

model Integration {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  name           String
  config         Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

model SystemConfig {
  id             String        @id @default(cuid())
  key            String
  value          String
  description    String?
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([key, organizationId])
}

model Wallet {
  id             String              @id @default(cuid())
  type           WalletType          @default(ORGANIZATION)
  organizationId String?             @unique
  balance        Float               @default(0)
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Float
  type        String
  description String?
  paymentId   String?
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id])
}

model Vehicle {
  id              String        @id @default(cuid())
  plateNumber     String        @unique
  type            String
  class           String?
  carrier         String?
  status          String        @default("ACTIVE")
  organizationId  String?
  lastMaintenance DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id])
  parcels         Parcel[]
}

model OTP {
  id        String   @id @default(cuid())
  parcelId  String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
}

model ParcelTracking {
  id          String       @id @default(cuid())
  parcelId    String
  status      ParcelStatus
  location    String?
  description String?
  timestamp   DateTime     @default(now())
  parcel      Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
}

enum AgentType {
  INDEPENDENT
  BUSINESS
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model PlatformAgent {
  id             String            @id @default(cuid())
  type           AgentType
  name           String
  email          String            @unique
  phone          String?           @unique
  businessName   String?
  businessReg    String?
  address        String?
  kycStatus      KycStatus         @default(PENDING)
  kycDocuments   Json?
  kycNotes       String?
  commissionRate Float?
  isActive       Boolean           @default(false)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  commissions    AgentCommission[]
}

model AgentCommission {
  id             String        @id @default(cuid())
  agentId        String
  periodStart    DateTime
  periodEnd      DateTime
  grossRevenue   Float         @default(0)
  commissionRate Float
  commissionDue  Float
  collectedAt    DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  agent          PlatformAgent @relation(fields: [agentId], references: [id])
}

enum ParcelStatus {
  PENDING
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PAID
  RECEIVED
  SENT
  DISPATCHED
  OFFLOADED
  AT_STATION
  IN_TRANSIT
  DELAYED
  DELIVERED
  CANCELED
  LOST
}

enum WalletType {
  ORGANIZATION
  PLATFORM
}

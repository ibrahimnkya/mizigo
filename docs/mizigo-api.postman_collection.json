  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.collectionVariables.get('requestSigningSecret');",
          "if (!secret) return;",
          "",
          "const method = (pm.request.method || 'GET').toUpperCase();",
          "const signable = ['POST', 'PUT', 'PATCH', 'DELETE'].includes(method);",
          "if (!signable) return;",
          "",
          "const pathWithQuery = pm.request.url.getPathWithQuery();",
          "if (pathWithQuery.startsWith('/api/v1/auth/') || pathWithQuery === '/api/v1/payments/callback') return;",
          "",
          "const stableStringify = (value) => {",
          "  if (value === null || value === undefined) return '';",
          "  if (Array.isArray(value)) return `[${value.map((v) => stableStringify(v)).join(',')}]`;",
          "  if (typeof value === 'object') {",
          "    const keys = Object.keys(value).sort();",
          "    return `{${keys.map((k) => JSON.stringify(k) + ':' + stableStringify(value[k])).join(',')}}`;",
          "  }",
          "  return JSON.stringify(value);",
          "};",
          "",
          "let canonicalBody = '';",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "  const raw = pm.request.body.raw || '';",
          "  try {",
          "    canonicalBody = stableStringify(JSON.parse(raw));",
          "  } catch (e) {",
          "    canonicalBody = raw;",
          "  }",
          "}",
          "",
          "const bodyHash = CryptoJS.SHA256(canonicalBody).toString();",
          "const timestamp = Date.now().toString();",
          "const nonce = `${Date.now()}-${Math.floor(Math.random() * 1000000000)}`;",
          "const payload = `${method}\\n${pathWithQuery}\\n${timestamp}\\n${nonce}\\n${bodyHash}`;",
          "const signature = CryptoJS.HmacSHA256(payload, secret).toString();",
          "",
          "pm.request.headers.upsert({ key: 'x-signature', value: signature });",
          "pm.request.headers.upsert({ key: 'x-signature-timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'x-signature-nonce', value: nonce });"
        ]
      }
    }
  ],
